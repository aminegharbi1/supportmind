    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select c.id as chunk_id, d.titre, d.version, c.texte,\n       round(ts_rank(c.recherche, websearch_to_tsquery('french', $1))::numeric, 4) as score\nfrom knowledge_chunks c\njoin knowledge_documents d on d.id = c.document_id\nwhere d.etat = 'publie'\n  and c.recherche @@ websearch_to_tsquery('french', $1)\norder by score desc\nlimit 3;",
        "options": {
          "queryReplacement": "={{ [$json.requete] }}"
        }
      },
